# Falling Sands - environment variables
#
# Copy to .env for local production-mode runs (`npm start`).
# Local dev (`npm run dev`) mocks the chain and ignores most of these.

# Required: app pubkey - the falling-sands canvas address.
# Reuse the canonical falling-sands pubkey from the dapp-starter examples
# deploy so this server and the canonical examples server converge on
# the same simulation state from chain history.
APP_PUBKEY=

# Optional: admin pubkey - permitted to issue
# {"app":"falling-sands","type":"reset"} memos. Any reset from a different
# sender is silently ignored. Unset means no admin (the client hides the
# reset UI).
ADMIN_PUBKEY=

# Sidecar node RPC URL.
# Inside the SV docker network this is http://usernode-node:3000.
# Outside docker, point at whichever node you want to talk to.
NODE_RPC_URL=http://usernode-node:3000

# Direct-to-node SSE for low-latency tx delivery (~sub-second vs.
# 5-60s explorer indexing lag). Requires a node built with
# --enable-recent-tx-stream. On by default.
USE_NODE_STREAM=1

# On-disk snapshot directory. The container default is /app/data,
# which the snapshot-store hydrates from Postgres on boot and writes
# back to Postgres on engine save.
SNAPSHOT_DIR=/app/data

# Postgres URL. Auto-injected by Social Vibecoding (a per-app database,
# isolated from other dapps). When unset, the snapshot-store logs a
# warning and falls back to disk-only persistence (no cross-restart
# durability, every cold boot replays from chain).
DATABASE_URL=

# HTTP port. Defaults to 3000 to match the SV scaffold.
PORT=3000
